# ── MERCADO PAGO ─────────────────────────────────────────────────
# Obtené estas claves en: https://www.mercadopago.com.ar/developers
# Usá las de PRUEBA primero (empiezan con TEST-) hasta que todo funcione.
# Luego reemplazalas por las de PRODUCCIÓN (empiezan con APP_USR-).

MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_WEBHOOK_SECRET=tu_clave_secreta_del_webhook

# ── URLS DE TU SITIO ─────────────────────────────────────────────
# En desarrollo local usá ngrok (ver guía abajo).
# En producción, poné la URL real de tu sitio.

SITE_URL=https://tu-sitio.com
SERVER_URL=https://tu-servidor.com

# ── SERVIDOR ─────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
